#!/bin/sh
# pre-push hook: block the push when lint is red.
#
# Installed by `make install-hooks` (copies this file to the repo's hooks
# dir, worktree-aware via `git rev-parse --git-path hooks`).
# Runs `make lint` (golangci-lint); if the linter is not installed, falls
# back to `go vet ./...` so pushes are still gated. To skip in an
# emergency: `git push --no-verify`.
set -u

cd "$(git rev-parse --show-toplevel)" || exit 1

if command -v golangci-lint >/dev/null 2>&1; then
	echo "pre-push: running 'make lint'..." >&2
	if ! make lint; then
		echo "pre-push: lint failed — push blocked. Fix the issues above and retry." >&2
		exit 1
	fi
else
	echo "pre-push: golangci-lint not found, falling back to 'go vet ./...'" >&2
	if ! go vet ./...; then
		echo "pre-push: go vet failed — push blocked." >&2
		exit 1
	fi
fi

echo "pre-push: lint clean." >&2
