#!/bin/sh
# pre-push hook: block the push when lint is red.
#
# Installed by `make install-hooks` (copies this file to the repo's hooks
# dir, worktree-aware via `git rev-parse --git-path hooks`).
# Runs `make lint` (golangci-lint); if the linter is not installed, falls
# back to `go vet ./...` so pushes are still gated. To skip in an
# emergency: `git push --no-verify`.
set -u

cd "$(git rev-parse --show-toplevel)" || exit 1

# Run golangci-lint if available
if command -v golangci-lint >/dev/null 2>&1; then
	echo "pre-push: running 'make lint'..." >&2
	if ! make lint; then
		echo "pre-push: lint failed — push blocked. Fix the issues above and retry." >&2
		exit 1
	fi
else
	echo "pre-push: golangci-lint not found, falling back to 'go vet ./...'" >&2
	if ! go vet ./...; then
		echo "pre-push: go vet failed — push blocked." >&2
		exit 1
	fi
fi

# Also run gofmt check on staged files only (golangci-lint v2 does not include gofmt).
# Checking only staged files prevents blocking pushes on pre-existing formatting
# drift in the repo; new/modified code must be properly formatted.
if command -v gofmt >/dev/null 2>&1; then
	unformatted=$(git diff --cached --name-only | xargs -I{} sh -c 'gofmt -l {} 2>/dev/null' | sort -u)
	if [ -n "$unformatted" ]; then
		echo "pre-push: gofmt violations found in staged files:" >&2
		echo "$unformatted" >&2
		echo "pre-push: gofmt failures — push blocked. Stage fixed files with 'gofmt -w <file>' and 'git add'." >&2
		exit 1
	fi
fi

echo "pre-push: lint clean." >&2