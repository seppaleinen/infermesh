<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="InferMesh.exe"
        Arguments=""
        InstallLocation="C:\Program Files\InferMesh\InferMesh">
    </Installer>
    <PackageInformation
        PackageName="InferMesh"
        PackageDisplayName="InferMesh"
        PublisherName="CN=InferMesh"
        PublisherDisplayName="InferMesh"
        Version="0.1.0.0"
        PackageDescription="Visual manager for the InferMesh inference pool">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.infermesh.desktop"
                Description="Visual manager for the InferMesh inference pool"
                DisplayName="InferMesh"
                ExecutableName="InferMesh.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>InferMesh</DisplayName>
            <PublisherDisplayName>InferMesh</PublisherDisplayName>
            <Description>Visual manager for the InferMesh inference pool</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="app.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
